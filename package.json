{
  "name": "wymlink-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start:dev": "npm run db:up && npm run dev",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:api": "cross-env PROCESS_ROLE=api node dist/index.js",
    "start:worker": "cross-env PROCESS_ROLE=worker node dist/index.js",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/scripts/migrate.ts",
    "test": "node db/tests/schema_test.mjs db/migrations/0001_wymlink_core.sql",
    "lint": "node -e \"console.log('No linter configured');\"",
    "docker:build": "docker build -t wymlink-backend .",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d",
    "db:stop": "docker-compose stop",
    "db:restart": "docker-compose restart",
    "db:clean": "docker-compose down -v --remove-orphans",
    "dev:stop": "npm run db:down",
    "migrate:prod": "node dist/scripts/migrate.js",
    "admin:create": "tsx src/scripts/createSuperAdmin.ts",
    "admin:reset-mfa": "tsx src/scripts/resetAdminMfa.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.20.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "swagger-ui-express": "^5.0.1",
    "undici": "^6.21.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.4",
    "supertest": "^7.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
