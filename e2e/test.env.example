# Settings for running the backend against the LOCAL test stack (copy to e2e/test.env).
# Load it with DOTENV_CONFIG_PATH so the real .env (live database, live Peyflex token) is
# never read: every value the backend needs is set here, all of them local or fake.
NODE_ENV=development
PORT=4000
PROCESS_ROLE=all
CORS_ORIGIN=http://localhost:3000
# 3005: the website in dev mode; 8081: the mobile app's web build.
CORS_ORIGINS=http://localhost:3000,http://localhost:3005,http://localhost:8081
# 5433: the embedded database directly; 5434: through latency-proxy.mjs (live-like ~66 ms).
DATABASE_URL=postgres://postgres:password@localhost:5434/wymlink
PG_SSL=false
DB_MIGRATE_ON_START=true
JWT_ACCESS_SECRET=local-test-secret-local-test-secret-0123456789
KYC_HASH_SECRET=local-kyc-secret-local-kyc-secret-0123456789
PEYFLEX_BASE_URL=http://localhost:4590
PEYFLEX_API_TOKEN=fake-local-token
MONETA_API_URL=http://localhost:4592
MONETA_PARTNER_URL=http://localhost:4592
MONETA_PARTNER_CLIENT_ID=fake
MONETA_PARTNER_CLIENT_SECRET=fake
# Only for e2e-lanes.mjs (stand-in for Fixie, see fwd-proxy.mjs); leave unset otherwise.
# MONETA_PROXY_URL=http://user:pass@localhost:4596
TRUST_PROXY_HOPS=0
ADMIN_MFA_REQUIRED=false
API_DOCS_ENABLED=false
ADMIN_EMAIL=admin@test.local
ADMIN_PASSWORD=Admin-Pass-12345!
ADMIN_FIRST_NAME=Test
ADMIN_LAST_NAME=Admin
