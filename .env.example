# Wymlink backend — every variable the server reads. Copy to .env and fill in.
# Never commit real values. Secrets marked (secret) belong only in the host's settings.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# api = HTTP only, worker = background jobs only, all = both
PROCESS_ROLE=all

# --- Network / security --------------------------------------------------------
# Proxies in front of the API (Render = 1). 0 when running locally.
TRUST_PROXY_HOPS=0
# Shared with the web app server (same value there). Lets it pass the real client IP. (secret, 32+ chars)
BFF_SHARED_SECRET=
# Browser origins allowed to call this API directly. The web app goes through its own
# server, so leave empty in production (= no cross-site access). Comma separated.
CORS_ORIGINS=

# --- Database & Redis --------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wymnet
# true for Supabase / managed Postgres
PG_SSL=false
DB_MIGRATE_ON_START=false
REDIS_URL=redis://localhost:6379

# --- Auth ----------------------------------------------------------------------
# (secret) at least 32 random characters
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=86400

# --- Payments: Monnify (being replaced by Moneta) -----------------------------
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_SOURCE_ACCOUNT_NUMBER=

# --- Bills & airtime -----------------------------------------------------------
PEYFLEX_BASE_URL=https://client.peyflex.com.ng
PEYFLEX_API_TOKEN=
RELOADLY_API_CLIENT=
RELOADLY_API_SECRET=
# sandbox | production
RELOADLY_ENV=sandbox
TELECOM_RETRY_INTERVAL_SECONDS=60

# --- Email (OTP codes) -------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Wymlink <no-reply@example.com>"

# --- OTP / PIN policy (defaults shown) ----------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
TX_PIN_MAX_ATTEMPTS=5
TX_PIN_LOCK_SECONDS=300
PASSCODE_MAX_ATTEMPTS=5
PASSCODE_LOCK_SECONDS=300

# --- Optional tuning (defaults shown) -----------------------------------------
LOG_LEVEL=info
SERVICE_NAME=wymlink-backend
REQUEST_JSON_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=0
PG_QUERY_TIMEOUT_MS=0
DB_WAIT_MAX_ATTEMPTS=30
DB_WAIT_DELAY_MS=2000
# Local sandbox testing only; ignored in production.
MONNIFY_WEBHOOK_ALLOW_UNSIGNED=false
