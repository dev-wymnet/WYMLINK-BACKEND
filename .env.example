# Wymlink backend — every variable the server reads. Copy to .env and fill in.
# Never commit real values. Secrets marked (secret) belong only in the host's settings.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# api = HTTP only, worker = background jobs only, all = both
PROCESS_ROLE=all

# --- Network / security --------------------------------------------------------
# Proxies in front of the API (Render = 1). 0 when running locally.
TRUST_PROXY_HOPS=0
# Shared with the web app server (same value there). Lets it pass the real client IP. (secret, 32+ chars)
BFF_SHARED_SECRET=
# Browser origins allowed to call this API directly. The web app goes through its own
# server, so leave empty in production (= no cross-site access). Comma separated.
CORS_ORIGINS=

# --- Database ------------------------------------------------------------------
# Supabase: use the Session pooler URL (IPv4). Special characters in the password
# must be URL-encoded (! = %21).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wymnet
# true for Supabase / managed Postgres
PG_SSL=false
PG_POOL_MAX=5
# Also apply db/migrations at boot (the Docker entrypoint always applies them).
DB_MIGRATE_ON_START=false

# --- Auth & identity -----------------------------------------------------------
# (secret) at least 32 random characters
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=86400
# Mobile app sessions (the app asks for its passcode on every open): 30 days
MOBILE_REFRESH_TOKEN_TTL_SECONDS=2592000
# (secret) keys the stored BVN/NIN hashes. Set once and NEVER change it: existing
# verifications would stop matching. At least 32 random characters.
KYC_HASH_SECRET=

# --- Moneta (virtual accounts, payouts, BVN) -----------------------------------
# Optional until configured: BVN checks fall back to staff review, payouts answer
# "coming soon". Moneta only accepts whitelisted IPs: MONETA_PROXY_URL routes calls
# through a fixed-IP HTTP proxy (e.g. Fixie) when set.
MONETA_API_URL=https://api.moneta.ng
MONETA_PARTNER_URL=https://app.moneta.ng/api/v1
MONETA_BVN_CLIENT_ID=
MONETA_BVN_CLIENT_SECRET=
MONETA_BVN_SERVICE_KEY=
MONETA_PARTNER_CLIENT_ID=
MONETA_PARTNER_CLIENT_SECRET=
MONETA_PROXY_URL=
# Alternative name for the same setting (use one): MONETA_PROXY=
# Payment-gateway service token (kept for when Moneta needs it on a call).
MONETA_SERVICE_TOKEN=
# Naira fee quoted per bank payout; Moneta takes it from the customer account on top.
MONETA_PAYOUT_FEE=30

# --- Bills & airtime -----------------------------------------------------------
PEYFLEX_BASE_URL=https://client.peyflex.com.ng
PEYFLEX_API_TOKEN=
# Airtime for customers staff switch to Reloadly (users.reloadly_enabled).
RELOADLY_API_CLIENT=
RELOADLY_API_SECRET=
# sandbox | production
RELOADLY_ENV=sandbox

# --- Email (OTP codes) -------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Wymlink <no-reply@example.com>

# --- OTP / PIN policy (defaults shown) ----------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
TX_PIN_MAX_ATTEMPTS=5
TX_PIN_LOCK_SECONDS=300
PASSCODE_MAX_ATTEMPTS=5
PASSCODE_LOCK_SECONDS=300

# --- Optional tuning (defaults shown) -----------------------------------------
LOG_LEVEL=info
SERVICE_NAME=wymlink-backend
REQUEST_JSON_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
# Global per-IP limit. Nigerian carriers put many customers behind one IP (CGNAT),
# so keep it generous in production.
RATE_LIMIT_MAX=600
PG_STATEMENT_TIMEOUT_MS=0
PG_QUERY_TIMEOUT_MS=0
DB_WAIT_MAX_ATTEMPTS=30
DB_WAIT_DELAY_MS=2000

# Staff sign-in asks for an authenticator-app code. Set to false to switch that off for
# everyone (e.g. while testers use the console); turn it back on when they are done.
ADMIN_MFA_REQUIRED=true

# Send email through the Wymlink Mail service (separate Vercel project) instead of SMTP.
# Needed on Render, which blocks outgoing SMTP ports. Both set = relay; otherwise SMTP above.
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=
